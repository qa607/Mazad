# Copy to .env for local overrides. .env is gitignored; never commit secrets.

# Required: an approved STAGING environment id, i.e. a file config/environments/<id>.json.
# There is no default. Currently approved: stg-154. Production is permanently blocked.
TEST_ENV=stg-154

# Optional: may only repeat the selected environment's approved baseURL exactly (else refused)
BASE_URL=

# Run headless (default: false). CI=true also forces headless.
HEADLESS=false

# Dev Root back-office account (staging only). Credentials are read from .env only, never
# from shell or CI variables, and are kept out of logs, reports, screenshots and test titles.
DEV_ROOT_PHONE=
DEV_ROOT_PASSWORD=

# Mazad customer (buyer) account for logged-in mobile tests (My Bids, Actions, Notifications).
MAZAD_BUYER_PHONE=
MAZAD_BUYER_PASSWORD=

# Appium server for mobile tests. Default: http://127.0.0.1:4723
APPIUM_URL=

# iOS device for Appium XCUITest tests: selected by UDID only (default: QA's iPhone,
# 00008120-0002703C1162601E, iOS 27.0.1). IOS_BUNDLE_ID must be on the APPROVED_IOS_BUILDS
# allowlist in src/mobile/ios/ios.config.ts (bundle + version + build); the installed build is
# checked on the device before any session. Environment flags never unblock iOS on their own.
# IOS_WDA_BUNDLE_ID: the WebDriverAgent runner already installed on the device, WITHOUT
#   ".xctrunner" (QA's iPhone: com.alsawaftah.motoryqa.WebDriverAgentRunner). When set, the
#   device session uses that preinstalled runner and never builds or signs WebDriverAgent.
# IOS_XCODE_ORG_ID: only when Appium must build WebDriverAgent (IOS_WDA_BUNDLE_ID unset).
IOS_UDID=
IOS_PLATFORM_VERSION=
IOS_BUNDLE_ID=
IOS_WDA_BUNDLE_ID=
IOS_XCODE_ORG_ID=
# ACCOUNT-ACTION APPROVAL SWITCHES (all default off; names only here: never set them in a shared
# file). The QA owner sets one to `true` in the local .env, for one run, only after the dedicated
# synthetic test account and the backend policy (config/ios-account-policy.ts) are confirmed.
# Recorded policy never authorizes an action by itself: a run needs the switches below as well, and
# an OTP request also needs a single-use permit (src/mobile/ios/account/otp-permit.ts). The physical
# iPhone has no request guard: a wrongly enabled switch lets the request reach staging.
# Each iOS run kind needs ALL of the switches listed next to it:
#   unregistered-login        IOS_ALLOW_ACCOUNT_ACTIONS
#   unregistered-otp-request  IOS_ALLOW_ACCOUNT_ACTIONS, MAZAD_ALLOW_OTP_REQUESTS
#   login (dealer)            IOS_ALLOW_ACCOUNT_ACTIONS, MAZAD_ALLOW_LOGOUT
#   otp-flow-chain            IOS_ALLOW_ACCOUNT_ACTIONS, MAZAD_ALLOW_OTP_REQUESTS
#   negative-chain            IOS_ALLOW_ACCOUNT_ACTIONS, MAZAD_ALLOW_OTP_REQUESTS (+ the negative-test approval)
#   otp-reset-chain           IOS_ALLOW_ACCOUNT_ACTIONS, MAZAD_ALLOW_OTP_REQUESTS, IOS_ALLOW_PASSWORD_RESET,
#                             MAZAD_ALLOW_PASSWORD_RESET, MAZAD_ALLOW_LOGOUT
#
# IOS_ALLOW_ACCOUNT_ACTIONS   protects any iOS test that calls the server with an account action:
#                             login attempts (registered or not) and every OTP-path request.
# IOS_ALLOW_PASSWORD_RESET    protects iOS tests that CHANGE a shared account password (reset).
# MAZAD_ALLOW_OTP_REQUESTS    protects every OTP request (Forgot Password Send), for a registered
#                             account or not; shared with the Web and Android suites.
# MAZAD_ALLOW_PASSWORD_RESET  protects saving a new password for a test account; shared with Web/Android.
# MAZAD_ALLOW_LOGOUT          protects signing a shared test account out (logins and resets end
#                             signed in, and cleanup must return the app to guest); shared with Web/Android.
# The guarded launch requires all five to be off.
IOS_ALLOW_ACCOUNT_ACTIONS=
IOS_ALLOW_PASSWORD_RESET=
MAZAD_ALLOW_OTP_REQUESTS=
MAZAD_ALLOW_PASSWORD_RESET=
MAZAD_ALLOW_LOGOUT=
# Dedicated synthetic dealer test account for the iOS account tests (staging only): its internal ID, its
# phone and its baseline password. All three come from here; no account detail is written in source code. Names only: fill them in the local .env, and only after the QA
# owner has confirmed the account in config/ios-account-policy.ts. Read from .env only (never
# from shell or CI variables), never printed or committed.
IOS_TEST_DEALER_ID=
IOS_TEST_DEALER_PHONE=
IOS_TEST_DEALER_PASSWORD=

# Android emulator started by `npm run emulator:start` (cold boot, headed). Default: Pixel_10_Pro_XL
ANDROID_AVD=
# Emulator DNS through NetBird, needed to reach staging (default: require).
#   require: launch only when NetBird DNS is verified to resolve staging to its internal IP
#   auto:    warn and launch with default DNS when it is not (staging then returns 403)
#   off:     never use NetBird DNS
EMULATOR_DNS_MODE=

# Optional: follow a specific sold auction across systems (default: newest sold auctions).
MAZAD_SOLD_AUCTION_ID=

# Staging-only fixed OTP, accepted for phone verification (login, forgot password).
# Never printed in logs or reports; read from this file only, never hardcoded in tests.
OTP_CODE=

# Name fragment used to find dedicated test accounts in the back office (Individuals, Dealers)
# instead of hardcoding a phone number. Default: "test".
TEST_ACCOUNT_NAME_FILTER=

# Production is permanently blocked for all automation (website, back office, Android, iOS).
# No variable, file or flag can enable it; see config/staging-environments.ts.

# One account per role, for tests/backend/permissions.spec.ts (staging only). Each account must
# have only that role. A role whose account is not set is skipped.
ROLE_AUCTION_SUPERVISOR_PHONE=
ROLE_AUCTION_SUPERVISOR_PASSWORD=
ROLE_CUSTOMER_SUPPORT_PHONE=
ROLE_CUSTOMER_SUPPORT_PASSWORD=
ROLE_AUCTION_TEAM_PHONE=
ROLE_AUCTION_TEAM_PASSWORD=
ROLE_OPERATION_PHONE=
ROLE_OPERATION_PASSWORD=
# Any role with no access to the auction lists, e.g. Marketing
ROLE_NO_AUCTION_ACCESS_PHONE=
ROLE_NO_AUCTION_ACCESS_PASSWORD=

# Supplier account (role supplierAdmin, staging only), for the auction visibility specs.
SUPPLIER_PHONE=
SUPPLIER_PASSWORD=
# Supplier ID of that account (its record ID in Users > Suppliers), for the data-scope checks.
SUPPLIER_ID=

# QC (quality control) account, staging only, for tests/backend/qc-login.spec.ts: a QC account
# must NOT be able to sign in to the Backend. The QC login tests are skipped while it is not set.
QC_PHONE=
QC_PASSWORD=

# ERPNext staging account (erp-stg-fixed.motory.com), for the ERPNext sync specs and npm run erp:compare.
# Read from .env only and never logged.
ERP_USER=
ERP_PASSWORD=

# ALLOW_PRODUCTION is deliberately NOT read from this file.
# To run against production, pass it per run: ALLOW_PRODUCTION=true TEST_ENV=prod npm test
