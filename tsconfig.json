{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@config/*": ["./config/*"],
      "@pages/*": ["./src/pages/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@locales": ["./src/locales/index.ts"],
      "@typings": ["./src/types/index.ts"],
      "@typings/*": ["./src/types/*"],
      "@api/*": ["./src/api/*"],
      "@mobile/*": ["./src/mobile/*"],
      "@utils/*": ["./src/utils/*"],
      "@test-data/*": ["./test-data/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
